# Copy this file to ".env" and adjust the paths for your machine.
# Both are optional — if unset, the app looks for ffmpeg/node on your PATH.

# Directory containing the ffmpeg executable (its bin folder).
FFMPEG_LOCATION=D:\apps\ffmpeg\ffmpeg-2026-03-30-git-e54e117998-essentials_build\bin

# Full path to the node executable.
NODE_PATH=C:\Program Files\nodejs\node.exe

# --- Optional: cookies, to reach age-restricted / region-locked videos ---
# Preferred: a cookies.txt file (Netscape format) exported from your browser.
# Reliable even on modern Chrome/Edge, which encrypt their cookie stores.
# COOKIES_FILE=D:\path\to\cookies.txt

# Alternative: read cookies straight from a browser profile. Often fails on
# current Chrome/Edge (locked DB / app-bound encryption). Ignored if
# COOKIES_FILE is set. Values: chrome, edge, firefox, brave, opera, vivaldi.
# COOKIES_FROM_BROWSER=firefox
